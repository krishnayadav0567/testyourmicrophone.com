{
  "name": "testyourmicrophone.com",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first browser microphone testing site with Google Search Console and SEO health automation",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "gsc:fetch": "node scripts/fetch-gsc-issues.mjs",
    "gsc:mock": "node scripts/fetch-gsc-issues.mjs --mock",
    "gsc:submit": "node scripts/submit-sitemap.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:seo": "node scripts/monitor-production.mjs --local",
    "gsc:automate": "node scripts/automate-gsc-issues.mjs",
    "bing:fetch": "node scripts/automate-bing-issues.mjs --no-sitemap --no-indexnow",
    "bing:submit": "node scripts/automate-bing-issues.mjs --no-indexnow",
    "bing:indexnow": "node scripts/submit-indexnow.mjs",
    "bing:mock": "node scripts/automate-bing-issues.mjs --mock",
    "bing:automate": "node scripts/automate-bing-issues.mjs",
    "seo:all": "npm run gsc:automate && npm run bing:automate"
  },
  "devDependencies": {
    "googleapis": "^189.0.0"
  }
}
